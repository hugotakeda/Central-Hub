{
  "name": "central-hub",
  "private": true,
  "version": "0.0.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc --noEmit -p protocol/tsconfig.json",
    "measure:bundle": "node scripts/measure-bundle.mjs"
  },
  "dependencies": {
    "@openmouse/keyboard-protocol": "1.1.0",
    "@openmouse/protocol": "0.48.0",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "1.43.0",
    "preact": "10.29.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  },
