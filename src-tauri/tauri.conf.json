{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Central Hub",
  "version": "0.9.1",
  "identifier": "com.centralhub.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Central Hub", "width": 1100, "height": 750, "minWidth": 800, "minHeight": 560, "center": true, "decorations": false, "backgroundColor": "#0D0D0D" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Seu painel local de periféricos",
    "category": "Utility",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "languages": ["PortugueseBR"], "displayLanguageSelector": false }, "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
